# ── Server ──────────────────────────────────────────────────────────────────
# Port the API + WebSocket server listens on
PORT=3001
# 'production' disables dev features (quick-login buttons, ghost teammate)
NODE_ENV=development
# Signs the auth cookie — set a long random value in production
COOKIE_SECRET=change-me-in-production
# Set to 1 when serving over HTTPS to mark the auth cookie Secure
# COOKIE_SECURE=1

# ── Data ────────────────────────────────────────────────────────────────────
# All runtime data lives here: project git repos, session worktrees, sqlite db
# LOOM_DATA_DIR=./data
# Override the sqlite file location (default: <LOOM_DATA_DIR>/loom.db)
# LOOM_SQLITE_PATH=./data/loom.db
# When set, Postgres is used instead of SQLite (same schema, drizzle migrations
# in apps/server/drizzle/pg run automatically at boot)
# DATABASE_URL=postgres://loom:loom@localhost:5432/loom

# ── AI provider ─────────────────────────────────────────────────────────────
# Unset → the deterministic MockAgentProvider (full product works, zero cost).
# Set → real Claude with streaming + tool use, zero other changes needed.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5
# Cheap model used for commit summaries / plain-English explanations
# ANTHROPIC_SUMMARY_MODEL=claude-3-5-haiku-latest
