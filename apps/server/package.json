{
  "name": "@loom/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PORT=3001 tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.config.sqlite.ts && drizzle-kit generate --config drizzle.config.pg.ts",
    "gc": "tsx src/scripts/gc.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@fastify/cookie": "^9.4.0",
    "@fastify/rate-limit": "9.1.0",
    "@fastify/static": "^7.0.4",
    "@loom/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "execa": "^9.5.2",
    "fastify": "^4.29.0",
    "ioredis": "5.4.1",
    "pg": "^8.13.1",
    "pino": "9.5.0",
    "tsx": "^4.19.2",
    "ulid": "^2.3.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
