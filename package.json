{
  "name": "loom",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @loom/server --filter @loom/web run dev",
    "seed": "pnpm --filter @loom/server run seed",
    "build": "pnpm --filter @loom/web run build",
    "test": "pnpm --filter @loom/shared run test && pnpm --filter @loom/server run test",
    "check": "pnpm -r run check",
    "e2e": "pnpm --filter @loom/web build && pnpm --filter @loom/web run e2e",
    "deploy:vercel": "node scripts/build-vercel.mjs && vercel deploy --prebuilt --prod --yes"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "esbuild": "0.24.2"
  }
}
